DATABASE_URL=sqlite:///./backoffice.db
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_TEACHER_EMAIL=professor@example.com
BOOTSTRAP_TEACHER_PASSWORD=change-this-to-a-strong-password
BOOTSTRAP_STUDENT_PASSWORD=change-this-to-a-different-strong-password
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ENABLE_SWAGGER_DEMO_ACCOUNTS=false
# true: preenche o painel de métricas com histórico e tráfego emulados (marcados como demo).
ENABLE_DEMO_METRICS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DEBUG também mostra os spans de banco (db.*).
LOG_LEVEL=INFO
# Rate limiting de entrada (por IP no login, por professor no upload).
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=10
# Fecho de semestre (gera resumos LLM para toda a turma), por professor.
TERM_CLOSE_RATE_LIMIT_PER_MINUTE=5
# Lease do fecho: impede dois fechos simultâneos; expira se o processo cair.
TERM_CLOSING_LEASE_SECONDS=900
GRADE_SUMMARY_PROVIDER=mock
# template: usa um resumo determinístico se o LLM falhar; none: marca o aluno como falha.
GRADE_SUMMARY_FALLBACK=template
GRADE_NOTIFICATION_PROVIDER=mock
GRADE_MAX_CONCURRENCY=5
GRADE_MAX_UPLOAD_SIZE_MB=10
# Lease por aluno: impede que execuções concorrentes notifiquem o mesmo aluno.
GRADE_PROCESSING_LEASE_SECONDS=300
# Teto de custo LLM por execução; ao atingir, os restantes usam o template. Vazio = sem teto.
GRADE_MAX_COST_USD_PER_EXECUTION=1.0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MAX_COMPLETION_TOKENS=180
# Orçamento do prompt (sistema + utilizador); acima dele, só o nome é truncado.
LLM_MAX_PROMPT_TOKENS=400
# Throttling de saída para o provedor LLM (token bucket por processo).
LLM_REQUESTS_PER_MINUTE=60
# Configuração ilustrativa por 1.000 tokens; confirme o preço do modelo escolhido.
LLM_INPUT_USD_PER_1K_TOKENS=0.00015
LLM_OUTPUT_USD_PER_1K_TOKENS=0.0006
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
